# ==========================================================================
# ANAHTAR TESLİM SERA — Apache yapılandırması (Natro / cPanel)
# ==========================================================================
# Not: Sunucuda mod_rewrite açık olmalıdır. cPanel'de varsayılan olarak açıktır.

Options -Indexes +FollowSymLinks
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# --- 1. HTTPS zorunlu -----------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- 2. www'lu adres zorunlu ---------------------------------------------
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- 3. .php uzantılı adresleri temiz adrese yönlendir --------------------
# /surec.php  ->  /surec   (301, tek bir kanonik adres için)
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- 4. Blog yazıları -----------------------------------------------------
# /blog/sera-sulama-otomasyonunun-onemi  ->  blog/yazi.php?slug=...
RewriteRule ^blog/([a-z0-9\-]+)/?$ blog/yazi.php?slug=$1 [L,QSA]

# --- 5. Temiz adresler ----------------------------------------------------
# /surec -> surec.php ;  /hizmetler/sera-kurulumu -> hizmetler/sera-kurulumu.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# --- 6. Sitemap -----------------------------------------------------------
RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# --- Hata sayfaları -------------------------------------------------------
ErrorDocument 404 /404.php

# --- Gizli klasörler ------------------------------------------------------
# Bu klasörler tarayıcıdan doğrudan açılamamalı.
RedirectMatch 404 ^/(inc|storage|content)/
<FilesMatch "\.(jsonl|log|md|sql|bak|ini)$">
  Require all denied
</FilesMatch>
<Files ".htaccess">
  Require all denied
</Files>

# --- Güvenlik başlıkları --------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Sıkıştırma -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# --- Tarayıcı önbelleği ---------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/svg+xml     "access plus 1 year"
  ExpiresByType text/css          "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html         "access plus 0 seconds"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddCharset UTF-8 .html .css .js .php
</IfModule>
